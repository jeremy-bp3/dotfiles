# Brewfile

cask_args appdir: "/Applications"

tap "anomalyco/tap"

{{ if eq .profile "work" }}
tap "hashicorp/tap"
tap "temporalio/brew"
{{ end }}


# CLI tools
brew "bat"
brew "direnv"
brew "eza"
brew "fd"
brew "fzf"
brew "gh"
brew "hunk"
brew "jq"
brew "lazygit"
brew "mise"
brew "neovim"
brew "opencode", tap: "anomalyco/tap"
brew "ripgrep"
brew "sesh"
brew "tmux"
brew "tree-sitter"
brew "wget"
brew "zoxide"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "zsh-completions"

{{ if eq .profile "work" }}
brew "tcld", tap: "temporalio/brew"
brew "temporal"
brew "vault", tap: "hashicorp/tap"
{{ end }}

